{
  "name": "appointment-preparation-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > src/types/database.generated.ts",

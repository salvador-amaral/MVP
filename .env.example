# ---- Supabase ----
# Create a project at https://supabase.com and paste the values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket name for client files (must be private)
SUPABASE_STORAGE_BUCKET=client-files

# ---- Resend (email) ----
RESEND_API_KEY=re_xxxxxxxxxxxx
# The domain/from you verified in Resend
EMAIL_FROM="Estúdio Contábil <no-reply@seudominio.com>"
# Public base URL used to build magic links in emails
APP_URL=http://localhost:3000

# ---- Inngest (background jobs / automatic reminders) ----
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
# Comma separated list of the scheduled ("send-reminders") function IDs you
# want to actually run in this environment, e.g. "dev"
INNGEST_ENV=dev

# ---- Vercel Cron (alternative to Inngest) ----
# Secret required by GET /api/cron/reminders. Vercel Cron sends it automatically
# as `Authorization: Bearer <secret>`; manual calls may use `x-cron-secret`.
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leaving the placeholder below means the worker endpoint is effectively open.
CRON_SECRET=replace-with-a-long-random-value

# ---- Local testing only ----
# Lifts the read-only staff preview on the client portal so you can walk the
# client flow (upload / answer) while signed in as an accountant.
# NEVER set this to true in production.
PORTAL_ALLOW_STAFF_EDITS=false
